int theme_refresh_applies=0;
void apply_current_theme(){++theme_refresh_applies;for(auto entry:refreshes)entry.second.first(entry.second.second,theme);}

struct CardPalette{bool has_sensor_color=false;uint32_t surface_sensor_val=0;};
// @production_helpers
bool apply_subpage_back_colors(lv_obj_t *o,const std::string&,const DisplayProfile&){apply_button_colors(o,true,theme.surface_card,true,theme.surface_card);return true;}

void ha_release_callbacks_for_owner(void *owner);
#include "button_grid_power.h"

namespace esphome {struct StringRef {std::string value;const char *c_str()const{return value.c_str();}size_t size()const{return value.size();}};}
struct ParsedCfg {std::string label="Power Dashboard",precision,home="sensor.h",solar="sensor.s",grid="sensor.g",battery="sensor.b",soc="sensor.soc";};
namespace espcontrol::power {
struct TestConfig {std::string home_entity,solar_entity,grid_entity,battery_entity,battery_soc_entity;bool invert_grid=false,invert_battery=false;};
TestConfig decode_config_v1(const ParsedCfg &c){return {c.home,c.solar,c.grid,c.battery,c.soc};}
}
void *callback_owner=nullptr;
struct Binding {void *owner;std::string entity,attribute;std::function<void(esphome::StringRef)> callback;};
std::vector<Binding> bindings;
void ha_release_callbacks_for_owner(void *owner){bindings.erase(std::remove_if(bindings.begin(),bindings.end(),[&](auto &b){return b.owner==owner;}),bindings.end());subscriptions=bindings.size();}
struct HaCallbackOwnerScope {void *previous;HaCallbackOwnerScope(void *o):previous(callback_owner){callback_owner=o;}~HaCallbackOwnerScope(){callback_owner=previous;}};
constexpr int HA_SUBSCRIPTION_SCOPE_DEFAULT=1;
bool ha_subscribe_state(const std::string &id,std::function<void(esphome::StringRef)> cb,int,bool){bindings.push_back({callback_owner,id,"",cb});++subscriptions;return true;}
bool ha_subscribe_attribute(const std::string &id,const std::string &attribute,std::function<void(esphome::StringRef)> cb,int,bool){bindings.push_back({callback_owner,id,attribute,cb});++subscriptions;return true;}
void (*&ha_retained_state_invalidated_handler())(){static void(*cb)()=nullptr;return cb;}
int parse_precision(const std::string &s){return s.empty()?0:std::stoi(s);}

template<class T>T *grid_delete_with_owner(lv_obj_t *o,T *p){lv_obj_add_event_cb(o,[](lv_event_t *e){delete static_cast<T*>(lv_event_get_user_data(e));},LV_EVENT_DELETE,p);return p;}
std::vector<PowerCardCtx*> main_allocations;
template<class T>T *grid_track_runtime_allocation(lv_obj_t*,T *p){main_allocations.push_back(p);return p;}

namespace espcontrol { enum class DisplayTakeoverKind; }
namespace esphome::artwork_image { class ArtworkImage; }
using DisplayModalProfile=espcontrol::modal::DeviceProfile;
// @grid_config
namespace espcontrol::cards {
namespace card_runtime {enum class CardDriverId {POWER,SUBPAGE,OTHER};}
enum class Surface {MAIN_GRID,SUBPAGE};
struct Context {struct {card_runtime::CardDriverId driver=card_runtime::CardDriverId::POWER;}runtime;Surface surface=Surface::MAIN_GRID;};
void sensor_driver_apply_background(BtnSlot &s,const CardPalette&p){s.btn->bg=p.surface_sensor_val;}
}
// @navigation_helpers
#include "button_grid_power_driver.h"

BtnSlot make_slot(bool main){
  BtnSlot s;s.btn=lv_obj_create(nullptr);s.btn->w=340;s.btn->h=160;s.config=main?s.btn:nullptr;
  s.icon_lbl=lv_label_create(s.btn);s.text_lbl=lv_label_create(s.btn);
  s.sensor_container=create_card_sensor_container(s.btn,&sensor_font,&label_font,
    lv_color_hex(theme.text_primary),&s.sensor_lbl,&s.unit_lbl);
  s.subpage_lbl=lv_label_create(s.btn);s.subpage_lbl->w=16;
  s.secondary_lbl=lv_label_create(s.btn);
  apply_button_colors(s.btn,true,current_button_primary_color(),true,theme.surface_card);return s;
}
void publish(std::string id,std::string value,std::string attribute="",bool settle=true){
  auto copy=bindings;for(auto &b:copy)if(b.entity==id&&b.attribute==attribute)b.callback({value});
  if(settle)advance(200);
}
int main(){
  using namespace espcontrol::cards;
  using espcontrol::power::Reading;
  using espcontrol::power::ReadingValidity;
  assert(power_reading_text({-.4,ReadingValidity::VALID},0)=="0 W");
  assert(power_reading_text({-.004,ReadingValidity::VALID},2)=="0.00 W");
  assert(power_reading_text({-500,ReadingValidity::VALID},0)=="-500 W");
  assert(power_reading_text({35000,ReadingValidity::VALID},0)=="35000 W");
  auto slot=make_slot(true);ParsedCfg cfg;Context context;DisplayProfile profile;profile.fonts.small_text=&small_font;
  assert(power_driver_setup_visual(slot,cfg,context,{},GridConfig{},2));
  assert(!lv_obj_has_flag(slot.subpage_lbl,LV_OBJ_FLAG_HIDDEN));
  assert(slot.subpage_lbl->x==0&&slot.subpage_lbl->y==2); // upstream profile defaults
  assert(slot.btn->flags&LV_OBJ_FLAG_CLICKABLE);
  assert(!(slot.btn->flags&LV_OBJ_FLAG_CHECKABLE));
  assert(slot.btn->bg==0x313131); // native card, never the sensor surface
  // Execute the actual main-grid subpage-entry driver, not Power's arrow.
  Context navigation;navigation.runtime.driver=card_runtime::CardDriverId::SUBPAGE;
  GridConfig grid{};grid.subpage_chevrons_enabled=false;grid.subpage_chevron_x=4;grid.subpage_chevron_y=-2;
  assert(navigation_driver_refresh_layout(slot,cfg,navigation,grid));
  assert(slot.subpage_lbl->flags&LV_OBJ_FLAG_HIDDEN);
  grid.subpage_chevrons_enabled=true;
  assert(navigation_driver_refresh_layout(slot,cfg,navigation,grid));
  assert(!(slot.subpage_lbl->flags&LV_OBJ_FLAG_HIDDEN));
  assert(slot.subpage_lbl->x==4&&slot.subpage_lbl->y==-2);
  auto *subpage_screen=lv_obj_create(nullptr);
  lv_obj_set_user_data(slot.btn,subpage_screen);
  assert(navigation_driver_handle_main_click(navigation,cfg,slot.btn));
  assert(loaded_screen==subpage_screen);
  lv_scr_load_anim(slot.btn,LV_SCR_LOAD_ANIM_NONE,0,0,false);assert(loaded_screen==slot.btn);
  lv_obj_set_user_data(slot.btn,nullptr);lv_obj_del(subpage_screen);
  power_driver_refresh_layout(slot,context,GridConfig{},2);
  assert(slot.secondary_lbl->font==slot.text_lbl->font);
  assert(slot.text_lbl->w==slot.secondary_lbl->w&&slot.text_lbl->w<slot.btn->w);
  assert(slot.text_lbl->max_h<=slot.btn->h-slot.sensor_container->h-slot.text_lbl->font->line_height-6);
  assert(power_driver_bind_data(slot,cfg,context,profile,GridConfig{}));assert(subscriptions==10);
  for(auto id: {"sensor.s","sensor.h","sensor.g","sensor.b"})publish(id,"W","unit_of_measurement");
  publish("sensor.s","1500");publish("sensor.h","1000");publish("sensor.g","0");publish("sensor.b","-500");
  assert(slot.sensor_lbl->text=="1000"&&slot.unit_lbl->text=="W");assert(slot.secondary_lbl->text=="Charging");
  assert(slot.sensor_container->cross==LV_FLEX_ALIGN_END&&slot.unit_lbl->pad_bottom==6);
  assert(slot.unit_lbl->font==&label_font&&slot.sensor_lbl->font==&sensor_font);
  for(const char *watts:{"9","923","1042","3500","35000"}){
    publish("sensor.h",watts);lv_obj_update_layout(slot.sensor_container);
    assert(slot.sensor_lbl->w==LV_SIZE_CONTENT&&slot.sensor_container->w==LV_SIZE_CONTENT);
    assert(slot.unit_lbl->x==slot.sensor_lbl->x+lv_obj_get_width(slot.sensor_lbl));
    assert(lv_obj_get_width(slot.sensor_container)<=slot.secondary_lbl->w);
    assert(slot.unit_lbl->text=="W");
  }
  publish("sensor.h","1000");
  auto *card=power_card_for_button(slot.btn);
  // Reproduce a mixed HA snapshot: no tolerance increase or retained invalid
  // arrows. Publish latest readings together at a non-extendable 200 ms deadline.
  power_flow_open(card);auto &batch_ui=power_flow_ui();
  publish("sensor.h","1200","",false);
  assert(card->data.model.calculation.validity==espcontrol::power::CalculationValidity::INCONSISTENT);
  assert(card->data.model.calculation.residual_w==-200&&card->data.model.calculation.tolerance_w==34);
  assert(batch_ui.values[1]->text=="1000 W"&&timers.size()==1);
  advance(100);publish("sensor.b","-300","",false);
  advance(99);assert(batch_ui.values[1]->text=="1000 W");
  advance(1);assert(batch_ui.values[1]->text=="1200 W"&&batch_ui.status->flags&LV_OBJ_FLAG_HIDDEN);
  assert(timers.empty());
  assert(std::any_of(diagnostic_logs.begin(),diagnostic_logs.end(),[](const auto &s){return s.find("source=callback state=1 watts=[1500.00,1200.00,0.00,-500.00]")==0;}));
  assert(std::any_of(diagnostic_logs.begin(),diagnostic_logs.end(),[](const auto &s){return s.find("source=publish state=2 watts=[1500.00,1200.00,0.00,-300.00]")==0;}));
  // Persistent discrepancy is visible at the original deadline despite more callbacks.
  publish("sensor.h","2000","",false);advance(100);
  publish("sensor.h","2100","",false);advance(100);
  assert(batch_ui.status->text=="Inconsistent readings"&&batch_ui.lines[0]->flags&LV_OBJ_FLAG_HIDDEN);
  // Oscillation around the 30 W threshold resolves using only the final snapshot.
  publish("sensor.h","1231","",false);advance(100);publish("sensor.h","1229","",false);advance(100);
  assert(batch_ui.status->flags&LV_OBJ_FLAG_HIDDEN);
  publish("sensor.h","1231");assert(batch_ui.status->text=="Inconsistent readings");
  // Unavailable clears immediately, cancels pending publication; no stale expiry.
  publish("sensor.h","1200","",false);assert(timers.size()==1);
  publish("sensor.s","unavailable","",false);assert(timers.empty()&&batch_ui.status->text=="Unavailable");
  advance(1000);assert(batch_ui.status->text=="Unavailable");
  publish("sensor.s","1500");publish("sensor.b","-500");publish("sensor.h","1000");
  publish("sensor.g","-0.4");assert(batch_ui.values[2]->text=="0 W");
  publish("sensor.g","0.4");assert(batch_ui.values[2]->text=="0 W");
  publish("sensor.g","0");
  publish("sensor.h","1100","",false);assert(timers.size()==1);
  power_cards_disconnected();assert(timers.empty()&&batch_ui.status->text=="Unavailable");
  for(auto id:{"sensor.s","sensor.h","sensor.g","sensor.b"})publish(id,"W","unit_of_measurement");
  publish("sensor.s","1500");publish("sensor.h","1000");publish("sensor.g","0");publish("sensor.b","-500");
  assert(batch_ui.status->flags&LV_OBJ_FLAG_HIDDEN);power_flow_hide();
  assert(power_reading_text({3500,espcontrol::power::ReadingValidity::VALID},0)=="3500 W");
  assert(power_reading_text({1042.25,espcontrol::power::ReadingValidity::VALID},2)=="1042.25 W");
  assert(power_driver_handle_main_click(context,cfg,slot.btn));
  assert(!(slot.btn->state&LV_STATE_CHECKED)&&title=="Power Dashboard");
  control_modal_force_close_active();
  power_driver_refresh_layout(slot,context,GridConfig{},1);
  assert(slot.sensor_container->flags&LV_OBJ_FLAG_HIDDEN);
  assert(slot.secondary_lbl->flags&LV_OBJ_FLAG_HIDDEN);
  assert(slot.btn->w==340); // no neighbor/cell/layout mutation
  power_driver_refresh_layout(slot,context,GridConfig{},2);
  assert(!(slot.sensor_container->flags&LV_OBJ_FLAG_HIDDEN));
  // Compact portrait's compiled body font would enter the fixed ports.
  // The existing compact font is selected in place; card typography stays body.
  label_font.line_height=35;small_font.line_height=30;
  frame.sw=480;frame.sh=800;frame.panel_w=472;frame.panel_h=750;
  power_flow_open(card);
  assert(power_flow_ui().names[3]->font==&small_font);
  assert(slot.secondary_lbl->font==&label_font);
  control_modal_force_close_active();label_font.line_height=16;small_font.line_height=12;
  for(auto size: {std::array<int,2>{320,480},{480,480},{720,720},{1280,800},{800,480},{720,1280}}){
    card->display.modal.layout_family=size[0]==720&&size[1]==720
      ? DisplayModalLayoutFamily::LARGE_SQUARE : DisplayModalLayoutFamily::COMPACT_SQUARE;
    normal_title="18°C";
    frame.sw=size[0];frame.sh=size[1];frame.panel_w=size[0]-16;frame.panel_h=size[1]-50;
    power_flow_open(card);assert(subscriptions==10&&title=="Power Dashboard");
    auto &ui=power_flow_ui();assert(ui.lines[0]->events[0].data==&ui.paths[0]);
    auto count_stage=[](const char *prefix){return std::count_if(diagnostic_logs.begin(),diagnostic_logs.end(),[&](const auto &s){return s.find(prefix)==0;});};
    assert(ui.diagnostic_updates==1);
    const int update_logs=count_stage("stage=model.update.begin");
    const int live_objects=objects;
    for(int update=0;update<8;++update)power_flow_update(card);
    assert(ui.diagnostic_updates==3&&count_stage("stage=model.update.begin")==update_logs+2);
    assert(objects==live_objects&&subscriptions==10);
    const int geometry_logs=count_stage("bounds=battery.soc");
    const int overlay_begin=count_stage("stage=overlay.first_draw.begin");
    const int overlay_end=count_stage("stage=overlay.first_draw.post");
    send(ui.shell.overlay,LV_EVENT_DRAW_MAIN_BEGIN);send(ui.shell.overlay,LV_EVENT_DRAW_POST_END);
    send(ui.shell.overlay,LV_EVENT_DRAW_MAIN_BEGIN);send(ui.shell.overlay,LV_EVENT_DRAW_POST_END);
    assert(count_stage("stage=overlay.first_draw.begin")==overlay_begin+1);
    assert(count_stage("stage=overlay.first_draw.post")==overlay_end+1);
    assert(count_stage("bounds=battery.soc")==geometry_logs+1);
    assert(std::find(diagnostic_logs.begin(),diagnostic_logs.end(),"stage=open.ready item=-1")!=diagnostic_logs.end());
    const int path_begin=count_stage("stage=path.draw.begin item=0");
    send(ui.lines[0],LV_EVENT_DRAW_MAIN);
    assert(count_stage("stage=path.draw.begin item=0")==path_begin+1);
    send(ui.lines[0],LV_EVENT_DRAW_MAIN);assert(count_stage("stage=path.draw.begin item=0")==path_begin+1);
    drawn_lines.clear();drawn_arcs.clear();send(ui.lines[0],LV_EVENT_DRAW_MAIN);
    assert(drawn_lines.size()==2&&drawn_arcs.size()==1);
    assert(drawn_arcs[0].end_angle-drawn_arcs[0].start_angle==90);
    assert(drawn_arcs[0].radius==ui.paths[0].arc.radius+drawn_lines[0].width/2);
    assert(drawn_lines[0].round_start&&!drawn_lines[0].round_end);
    assert(!drawn_lines[1].round_start&&drawn_lines[1].round_end);
    assert(drawn_lines[0].width%2==0&&drawn_arcs[0].color.full==current_button_primary_color());
    drawn_lines.clear();drawn_arcs.clear();send(ui.lines[1],LV_EVENT_DRAW_MAIN);
    assert(drawn_lines.size()==1&&drawn_arcs.empty());
    auto saved=ui.paths[0];ui.paths[0].arc.radius=0;
    ui.paths[0].points[1]=ui.paths[0].points[2]={10,30};
    ui.paths[0].points[0]={10,10};ui.paths[0].points[3]={30,30};
    drawn_lines.clear();drawn_arcs.clear();send(ui.lines[0],LV_EVENT_DRAW_MAIN);
    assert(drawn_lines.size()==2&&drawn_arcs.empty());
    assert(drawn_lines[0].p1.x==drawn_lines[0].p2.x&&drawn_lines[1].p1.y==drawn_lines[1].p2.y);
    ui.paths[0]=saved;
    assert(ui.details[3]->color==theme.text_muted&&ui.soc->color==theme.text_muted);
    assert(ui.details[3]->mode==LV_LABEL_LONG_CLIP);
    assert(ui.soc->mode==LV_LABEL_LONG_CLIP);
    assert(ui.values[3]->text=="-500 W"); // normalized polarity is visible as well as caption
    assert(ui.details[3]->text=="Charging");
    // Hardware regression: labels must not inherit dashboard/diagram/area draw
    // frames. Assert the actual production parent chain and resolved bounds.
    lv_area_t path_bounds;lv_obj_get_coords(ui.area,&path_bounds);
    for(auto *node:ui.nodes){
      assert(node->parent==ui.shell.panel);
      lv_area_t b;lv_obj_get_coords(node,&b);
      assert(b.x1>=path_bounds.x1&&b.y1>=path_bounds.y1);
      assert(b.x2<=path_bounds.x2+1&&b.y2<=path_bounds.y2+1);
    }
    for(auto *icon:ui.icons){
      int levels=0;for(auto *p=icon;p&&p!=ui.shell.overlay;p=p->parent)++levels;
      assert(levels==5); // icon, icon cell, heading, node, panel
    }
    // Full-panel center remains authoritative with both small and large Back.
    const auto centered=[&](){
      auto *a=ui.area;
      lv_area_t area,solar,battery,home,grid;lv_obj_get_coords(a,&area);
      lv_obj_get_coords(ui.nodes[0],&solar);lv_obj_get_coords(ui.nodes[3],&battery);
      lv_obj_get_coords(ui.nodes[1],&home);lv_obj_get_coords(ui.nodes[2],&grid);
      const double cx=a->x+a->w/2.0, cy=a->y+a->h/2.0;
      assert(cx==frame.panel_w/2.0&&cy==frame.panel_h/2.0);
      assert(std::abs((solar.y1+solar.y2+battery.y1+battery.y2)/4.0-(area.y1+area.y2)/2.0)<=.5);
      assert(std::abs((home.x1+home.x2+grid.x1+grid.x2)/4.0-(area.x1+area.x2)/2.0)<=.5);
    };
    centered();frame.back_size=54;power_flow_layout();centered();
    frame.back_size=36;power_flow_layout();centered();
    for(size_t j=0;j<espcontrol::power::FLOW_POINT_COUNT;j++){
      const auto p=ui.paths[4].points[j],r=ui.paths[6].points[espcontrol::power::FLOW_POINT_COUNT-1-j];
      assert(p.x==r.x&&p.y==r.y); // including actual integer renderer quantization
    }
    assert(sizeof(PowerFlowUi)<=2100); // fixed storage, no extra LVGL objects
    auto *area=ui.area;const int count=objects;const auto point=ui.paths[0].points[0];
    assert(count<=68); // three-row nodes include bounded horizontal detail containers
    publish("sensor.s","unknown");assert(ui.lines[0]->flags&LV_OBJ_FLAG_HIDDEN);assert(ui.values[1]->text=="1000 W");
    assert(ui.status->text=="Unavailable");assert(slot.secondary_lbl->text=="Charging");
    publish("sensor.s","900");assert(ui.status->text=="Inconsistent readings");
    publish("sensor.s","1500");assert((ui.status->flags&LV_OBJ_FLAG_HIDDEN));
    theme.text_primary=0x212121;theme.surface_card=0xf5f5f5;theme_apply_grid_button(slot.btn,theme.surface_card,theme);
    assert(slot.text_lbl->color==0x212121&&ui.area==area&&objects==count);
    assert(ui.paths[0].points[0].x==point.x&&ui.paths[0].points[0].y==point.y);
    slot.btn->pressed_bg=0xffffff;slot.btn->state=LV_STATE_PRESSED;send(slot.btn,LV_EVENT_PRESSED);
    theme.surface_card=0x212121;theme_apply_grid_button(slot.btn,theme.surface_card,theme);
    assert(slot.btn->bg==0x212121&&slot.btn->pressed_bg==0xffffff);
    theme.surface_card=0xf5f5f5;theme_apply_grid_button(slot.btn,theme.surface_card,theme);
    assert(slot.sensor_lbl->color==0x212121&&slot.subpage_lbl->color==0x212121);
    slot.btn->state=0;send(slot.btn,LV_EVENT_RELEASED);
    assert(slot.btn->bg==0xf5f5f5); // release exposes the refreshed neutral surface
    slot.btn->flags|=LV_OBJ_FLAG_USER_1;slot.btn->bg=0x212121;
    theme_apply_grid_button(slot.btn,theme.surface_card,theme);
    assert(slot.btn->bg==0x212121&&slot.text_lbl->color==0xffffff); // explicit custom fill, even a token collision
    slot.btn->flags&=~LV_OBJ_FLAG_USER_1;theme_apply_grid_button(slot.btn,theme.surface_card,theme);
    ha_retained_state_invalidated_handler()();assert(slot.sensor_lbl->text=="--"&&ui.status->text=="Unavailable");
    for(auto id: {"sensor.s","sensor.h","sensor.g","sensor.b"})publish(id,"W","unit_of_measurement");
    publish("sensor.s","1500");publish("sensor.h","1000");publish("sensor.g","0");publish("sensor.b","-500");
    control_modal_force_close_active();assert(title=="18°C"&&subscriptions==10);
    normal_title="Subpage";power_flow_open(card);control_modal_force_close_active();assert(title=="Subpage");
  }
  // Native large-display grids: Back + Sensor slots left, diagram right three columns.
  card->grid_cols=5;card->grid_gap=10;card->continuous_corners=true;
  for(int rows:{3,4}){
    card->grid_rows=rows;
    card->display.modal.layout_family=rows==3?DisplayModalLayoutFamily::WIDE_LANDSCAPE:DisplayModalLayoutFamily::LARGE_LANDSCAPE;
    frame.sw=rows==3?1024:1280;frame.sh=rows==3?600:800;
    frame.panel_w=frame.sw-16;frame.panel_h=frame.sh-50;frame.inset=18;
    for(const char *language:{"en","de","fr","it","cs","pl","fi","ru","uk"}){
      set_espcontrol_language(language);
      const int applies_before=theme_refresh_applies;
      power_flow_open(card);auto &ui=power_flow_ui();
      assert(theme_refresh_applies==applies_before+1); // prime each new native owner after construction
      assert(subscriptions==10&&ui.grid.large&&ui.grid.diagram.cols==3&&ui.grid.diagram.rows==rows);
      assert(ui.dashboard->children.size()==6); // Back + four readings + Flow: no mega-card wrapper
      assert(ui.shell.panel->bg==theme.background&&ui.shell.panel->radius==0);
      assert(ui.diagram->bg==theme.surface_card&&ui.diagram->bg_opacity==LV_OPA_COVER);
      assert(ui.diagram->continuous&&ui.diagram->padding==card->slot.btn->padding);
      assert(ui.dashboard->layout==LV_LAYOUT_GRID&&ui.diagram->gcols==3&&ui.diagram->grows==rows);
      lv_area_t paths;lv_obj_get_coords(ui.area,&paths);
      for(auto *node:ui.nodes){
        assert(node->parent==ui.shell.panel);
        lv_area_t b;lv_obj_get_coords(node,&b);
        assert(b.x1>=paths.x1&&b.y1>=paths.y1&&b.x2<=paths.x2+1&&b.y2<=paths.y2+1);
      }
      // Preserve the diagram's own center despite shallower draw ownership.
      lv_area_t solar,battery,home,grid;lv_obj_get_coords(ui.nodes[0],&solar);
      lv_obj_get_coords(ui.nodes[3],&battery);lv_obj_get_coords(ui.nodes[1],&home);
      lv_obj_get_coords(ui.nodes[2],&grid);
      assert(std::abs((solar.y1+solar.y2+battery.y1+battery.y2)/4.0-(paths.y1+paths.y2)/2.0)<=.5);
      assert(std::abs((home.x1+home.x2+grid.x1+grid.x2)/4.0-(paths.x1+paths.x2)/2.0)<=.5);
      assert(ui.area->x+ui.area->w/2.0==ui.diagram->w/2.0);
      assert(ui.area->y+ui.area->h/2.0==ui.diagram->h/2.0);
      lv_area_t back_bounds,diagram_bounds;
      lv_obj_get_coords(ui.back_area,&back_bounds);lv_obj_get_coords(ui.diagram,&diagram_bounds);
      assert(back_bounds.x2<diagram_bounds.x1);
      assert(ui.shell.close_btn->flags&LV_OBJ_FLAG_HIDDEN);
      assert(ui.status->parent==ui.diagram&&ui.back_area->gcols==(rows==3?1:2));
      assert(ui.back_slot.icon_lbl->text=="\U000F0141");
      assert(ui.back_slot.text_lbl->text==espcontrol_i18n("Back"));
      publish("sensor.b","-35000");publish("sensor.g","-1042");publish("sensor.soc","78");publish("sensor.soc","%","unit_of_measurement");
      power_flow_layout();lv_obj_update_layout(ui.dashboard);
      assert(ui.values[3]->text=="-35000 W"&&ui.sidebar[3].sensor_lbl->text=="-35000"&&ui.sidebar[3].unit_lbl->text=="W");
      assert(ui.sidebar[2].sensor_lbl->text=="-1042"&&ui.sidebar[2].unit_lbl->text=="W");
      card->data.model.set_polarity({true,true});power_card_update(card);
      assert(ui.values[2]->text=="1042 W"&&ui.sidebar[3].sensor_lbl->text=="35000");
      assert(ui.sidebar[3].secondary_lbl->text==std::string("78% \u00b7 ")+espcontrol_i18n("Discharging"));
      card->data.model.set_polarity({false,false});power_card_update(card);
      assert(ui.sidebar[3].secondary_lbl->text==std::string("78% · ")+espcontrol_i18n("Charging"));
      assert(ui.sidebar[2].secondary_lbl->text==espcontrol_i18n("Exporting"));
      for(size_t i=0;i<4;++i){
        auto &side=ui.sidebar[i];auto *n=side.btn;
        assert(n->continuous&&!(n->flags&LV_OBJ_FLAG_CLICKABLE));
        assert(n->padding==card->slot.btn->padding);
        assert(n->x+n->w<=ui.diagram->x);
        assert(n->y>=0&&n->y+n->h<=ui.dashboard->h);
        assert(side.icon_lbl->flags&LV_OBJ_FLAG_HIDDEN);
        assert(side.subpage_lbl->flags&LV_OBJ_FLAG_HIDDEN);
        assert(side.sensor_lbl->font==&sensor_font);
        assert(side.sensor_lbl->h==sensor_font.line_height); // long decimals remain one native-font row
        assert(side.text_lbl->max_h>=side.text_lbl->font->line_height); // first update cannot clamp before grid allocation
        assert(side.unit_lbl->font==card->slot.text_lbl->font);
        assert(side.unit_lbl->pad_bottom==6&&side.sensor_container->cross==LV_FLEX_ALIGN_END);
        assert(side.sensor_lbl->parent==side.sensor_container);
        int levels=0;for(auto *p=side.sensor_lbl;p&&p!=ui.shell.overlay;p=p->parent)++levels;
        assert(levels==5); // no deeper than the corrected diagram text chain
        assert(side.secondary_lbl->flags&LV_OBJ_FLAG_HIDDEN || side.secondary_lbl->font==side.text_lbl->font);
      }
      assert(ui.sidebar[2].secondary_lbl->text_opacity==LV_OPA_70);
      assert(ui.sidebar[3].secondary_lbl->text_opacity==LV_OPA_70);
      assert(ui.sidebar[0].secondary_lbl->flags&LV_OBJ_FLAG_HIDDEN);
      assert(ui.sidebar[1].secondary_lbl->flags&LV_OBJ_FLAG_HIDDEN);
      assert(refreshes.size()==1&&refreshes.count(ui.back_area)==1);
      const auto saved_theme=theme;
      for(auto sensor_surface:{0xffffffu,0x212121u}){
        theme.surface_sensor=sensor_surface;theme.surface_card=sensor_surface==0xffffff?0xffffff:0x313131;
        theme.text_primary=sensor_surface==0xffffff?0x212121:0xffffff;
        auto binding=refreshes.at(ui.back_area);binding.first(binding.second,theme);
        for(auto &side:ui.sidebar)assert(side.btn->bg==sensor_surface&&side.sensor_lbl->color==theme.text_primary);
        assert(ui.back_area->bg==theme.surface_card&&ui.back_area->pressed_bg==theme.surface_card);
        ui.back_area->state=LV_STATE_PRESSED;send(ui.back_area,LV_EVENT_PRESSED);
        assert(ui.back_slot.text_lbl->color==display_text_color_for_bg(theme.surface_card));
        ui.back_area->state=0;send(ui.back_area,LV_EVENT_RELEASED);
      }
      theme=saved_theme;auto binding=refreshes.at(ui.back_area);binding.first(binding.second,theme);
      const int count=objects;assert(count<=113&&sizeof(PowerFlowUi)<=2304);
      publish("sensor.soc","unavailable");publish("sensor.b","unavailable");
      assert(ui.sidebar[3].secondary_lbl->text==espcontrol_i18n("Unavailable"));
      assert(ui.values[3]->text=="--"&&ui.sidebar[3].sensor_lbl->text=="--"&&ui.sidebar[3].unit_lbl->text.empty());
      power_flow_layout();assert(objects==count&&subscriptions==10);
      // A rotated viewport falls back without deleting/recreating model or view.
      std::swap(frame.panel_w,frame.panel_h);power_flow_layout();
      assert(!ui.grid.large&&ui.sidebar[0].btn->flags&LV_OBJ_FLAG_HIDDEN);
      assert(!(ui.shell.close_btn->flags&LV_OBJ_FLAG_HIDDEN)&&ui.back_area->flags&LV_OBJ_FLAG_HIDDEN);
      assert(ui.area->x+ui.area->w/2.0==frame.panel_w/2.0);
      assert(ui.area->y+ui.area->h/2.0==frame.panel_h/2.0);
      std::swap(frame.panel_w,frame.panel_h);power_flow_layout();assert(ui.grid.large&&objects==count);
      send(ui.back_area,LV_EVENT_CLICKED);assert(subscriptions==10&&!power_flow_ui().card&&refreshes.empty());
      publish("sensor.b","-500");publish("sensor.g","0");
    }
  }
  set_espcontrol_language("nl");card->display.modal={};card->grid_cols=3;card->grid_rows=3;
  frame.sw=480;frame.sh=480;frame.panel_w=464;frame.panel_h=430;frame.inset=18;
  power_flow_open(card);
  assert(power_flow_ui().nodes[1]->w<power_flow_ui().nodes[3]->w);
  auto &small_ui=power_flow_ui();
  const auto unchanged=espcontrol::power::flow_geometry(small_ui.area->w,small_ui.area->h,
    espcontrol::power::FlowFamily::SQUARE,small_ui.nodes[0]->w,small_ui.nodes[0]->h,small_ui.nodes[1]->w);
  for(size_t i=0;i<7;++i){
    assert(small_ui.paths[i].arc.radius==unchanged.arcs[i].radius);
    for(size_t j=0;j<espcontrol::power::FLOW_POINT_COUNT;++j){
      assert(small_ui.paths[i].points[j].x==espcontrol::power::flow_coordinate<int>(unchanged.paths[i][j].x));
      assert(small_ui.paths[i].points[j].y==espcontrol::power::flow_coordinate<int>(unchanged.paths[i][j].y));
    }
  }
  for(size_t i:{0,2,3,4})assert(small_ui.paths[i].arc.radius>0);
  power_flow_hide();
  set_espcontrol_language("en");frame.inset=8;card->display.modal={};card->grid_cols=1;card->grid_rows=1;
  fail_after=9;const int base_objects=objects;power_flow_open(card);
  assert(!power_flow_ui().card&&objects==base_objects&&subscriptions==10);fail_after=-1;
  power_flow_open(card);lv_obj_del(power_flow_ui().shell.overlay);
  assert(!power_flow_ui().card&&title=="Subpage"&&subscriptions==10);
  power_flow_open(card);delete main_allocations.back();main_allocations.clear();
  assert(!power_flow_ui().card&&!power_card_contexts()&&subscriptions==0);
  // Same permanent slot rebuilt under Light: no manual theme transition.
  apply_button_colors(slot.btn,true,current_button_primary_color(),true,theme.surface_card);
  assert(power_driver_setup_visual(slot,cfg,context,{},GridConfig{},2));
  assert(power_driver_bind_data(slot,cfg,context,profile,GridConfig{}));
  assert(subscriptions==10&&slot.text_lbl->color==theme.text_primary);
  assert(slot.btn->events.size()==2); // old event handlers replaced, no dangling userdata
  delete main_allocations.back();main_allocations.clear();
  lv_obj_del(slot.btn);
  auto sub=make_slot(false);context.surface=Surface::SUBPAGE;
  power_driver_setup_visual(sub,cfg,context,{},GridConfig{},2);power_driver_bind_data(sub,cfg,context,profile,GridConfig{});
  send(sub.btn,LV_EVENT_CLICKED);assert(power_flow_ui().card&&subscriptions==10);
  publish("sensor.soc","78");publish("sensor.soc","%","unit_of_measurement");
  assert(power_flow_ui().soc->text=="78% · ");
  auto &battery_ui=power_flow_ui();
  assert(battery_ui.nodes[3]->children.size()==3);
  assert(battery_ui.soc->parent==battery_ui.details[3]->parent);
  assert(battery_ui.soc->parent->flex==LV_FLEX_FLOW_ROW);
  publish("sensor.b","-1042");publish("sensor.b","W","unit_of_measurement");
  assert(battery_ui.values[3]->text=="-1042 W");
  assert(battery_ui.details[3]->text=="Charging");
  publish("sensor.g","-500");publish("sensor.g","W","unit_of_measurement");
  assert(battery_ui.values[2]->text=="-500 W");
  publish("sensor.soc","unavailable");assert(battery_ui.soc->text.empty());
  assert(battery_ui.details[3]->text=="Charging");
  publish("sensor.soc","78");publish("sensor.b","unavailable");
  assert(battery_ui.soc->text=="78% · "&&battery_ui.details[3]->text=="Unavailable");
  for(auto id:{"sensor.s","sensor.h"})publish(id,"W","unit_of_measurement");
  publish("sensor.s","1500","",false);publish("sensor.h","1000","",false);publish("sensor.g","0","",false);publish("sensor.b","-500","",false);assert(timers.size()==1);
  lv_obj_del(sub.btn);assert(timers.empty());advance(1000);assert(subscriptions==0&&objects==0&&!power_flow_ui().card&&!power_card_contexts());
  auto no_soc=make_slot(false);cfg.soc.clear();
  power_driver_setup_visual(no_soc,cfg,context,{},GridConfig{},2);
  power_driver_bind_data(no_soc,cfg,context,profile,GridConfig{});assert(subscriptions==8);
  power_flow_open(power_card_for_button(no_soc.btn));
  assert(power_flow_ui().soc->text.empty());
  lv_obj_del(no_soc.btn);assert(subscriptions==0&&objects==0&&!power_flow_ui().card);

