void lv_obj_set_pos(lv_obj_t *o,int x,int y){o->x=x+(o->parent?o->parent->padding:0);o->y=y+(o->parent?o->parent->padding:0);}
int lv_obj_get_width(lv_obj_t *o){
  if(o->w!=LV_SIZE_CONTENT)return o->w;
  int width=static_cast<int>(o->text.size())*static_cast<int>(o->font?o->font->line_height:16)/2;
  if(!o->children.empty()){width=0;for(auto *c:o->children)width+=lv_obj_get_width(c)+o->pad_column;width-=o->pad_column;}
  return std::min(width,o->max_w);
}
long lv_obj_get_height(lv_obj_t *o){return o->h;}
int lv_obj_get_x(lv_obj_t *o){return o->x-(o->parent?o->parent->padding:0);}
int lv_obj_get_y(lv_obj_t *o){return o->y-(o->parent?o->parent->padding:0);}
