  LV_EVENT_RELEASED=4, LV_EVENT_PRESS_LOST=5, LV_EVENT_CLICKED=6, LV_EVENT_DRAW_MAIN=7, LV_EVENT_DRAW_MAIN_BEGIN=8, LV_EVENT_DRAW_POST_END=9;
