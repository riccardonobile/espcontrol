void lv_obj_set_parent(lv_obj_t *o,lv_obj_t *parent){auto &v=o->parent->children;v.erase(std::remove(v.begin(),v.end(),o),v.end());o->parent=parent;parent->children.push_back(o);}
void lv_obj_update_layout(lv_obj_t *o){
  if(o->layout==LV_LAYOUT_GRID){
    int cols=0,rows=0;while(o->columns[cols]!=LV_GRID_TEMPLATE_LAST)++cols;while(o->rows[rows]!=LV_GRID_TEMPLATE_LAST)++rows;
    int w=lv_obj_get_content_width(o)-o->pad_column*(cols-1),h=lv_obj_get_content_height(o)-o->pad_row*(rows-1);
    for(auto *c:o->children){
      if(c->flags&LV_OBJ_FLAG_HIDDEN)continue;
      c->x=o->padding+w*c->gcol/cols+o->pad_column*c->gcol;
      c->y=o->padding+h*c->grow/rows+o->pad_row*c->grow;
      c->w=w*(c->gcol+c->gcols)/cols-w*c->gcol/cols+o->pad_column*(c->gcols-1);
      c->h=h*(c->grow+c->grows)/rows-h*c->grow/rows+o->pad_row*(c->grows-1);
    }
  }
  for(auto *c:o->children)lv_obj_update_layout(c);
  if(o->flex==LV_FLEX_FLOW_ROW){int total=0;for(auto *c:o->children)if(!(c->flags&LV_OBJ_FLAG_HIDDEN))total+=lv_obj_get_width(c)+o->pad_column;
    total=std::max(0,total-o->pad_column);int x=o->flex_center?std::max(0,(lv_obj_get_width(o)-total)/2):0;
    for(auto *c:o->children)if(!(c->flags&LV_OBJ_FLAG_HIDDEN)){c->x=x;x+=lv_obj_get_width(c)+o->pad_column;}}
  if(o->flex==LV_FLEX_FLOW_COLUMN){int total=0;for(auto *c:o->children)if(!(c->flags&LV_OBJ_FLAG_HIDDEN))total+=c->h+o->pad_row;
    total=std::max(0,total-o->pad_row);int y=o->flex_center?std::max(0,(o->h-total)/2):0;
    for(auto *c:o->children)if(!(c->flags&LV_OBJ_FLAG_HIDDEN)){c->x=std::max(0,(lv_obj_get_content_width(o)-lv_obj_get_width(c))/2);c->y=y;y+=c->h+o->pad_row;}}
  if(o->h==LV_SIZE_CONTENT){o->h=0;for(auto *c:o->children)o->h=std::max(o->h,c->h+c->pad_bottom);}
}
