std::vector<std::string> diagnostic_logs;
template<class... Args> void test_log(const char *tag,const char *format,Args... args){
  if(std::string(tag)!="power_diag"&&std::string(tag)!="power_balance")return;
  char text[256];snprintf(text,sizeof(text),format,args...);diagnostic_logs.emplace_back(text);
}
#define ESP_LOGW(...) test_log(__VA_ARGS__)

uint32_t test_now=0;
uint32_t lv_tick_get(){return test_now;}
struct lv_timer_t {void(*callback)(lv_timer_t*);void *data;uint32_t due;};
std::vector<lv_timer_t*> timers;
lv_timer_t *lv_timer_create(void(*cb)(lv_timer_t*),uint32_t period,void *data){auto *t=new lv_timer_t{cb,data,test_now+period};timers.push_back(t);return t;}
void *lv_timer_get_user_data(lv_timer_t *t){return t->data;}
void lv_timer_set_repeat_count(lv_timer_t*,int){}
void lv_timer_delete(lv_timer_t *t){timers.erase(std::find(timers.begin(),timers.end(),t));delete t;}
void advance(uint32_t ms){test_now+=ms;auto copy=timers;for(auto *t:copy)if(int32_t(test_now-t->due)>=0){t->callback(t);lv_timer_delete(t);}}
